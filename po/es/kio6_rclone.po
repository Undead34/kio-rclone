msgstr "Configuración…"

#: app/configwindow.cpp:181
#, kde-format
msgid "Directory listing settings"
msgstr "Configuración de los listados de directorios"

#: app/configwindow.cpp:193
#, kde-format
msgid "Open in Dolphin"
msgstr "Abrir en Dolphin"

#: app/configwindow.cpp:194
#, kde-format
msgid "Edit…"
msgstr "Editar…"

#: app/configwindow.cpp:195
#, kde-format

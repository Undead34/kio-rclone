#: src/kio/entrybuilder.cpp:37 app/main.cpp:24 app/configwindow.cpp:149
#, kde-format
msgid "Rclone Remotes"
msgstr "Remotos de Rclone"

#: src/kio/entrybuilder.cpp:52
#, kde-format
msgid "Configure Remotes…"
msgstr "Configurar remotos…"

#: src/kio/entrybuilder.cpp:132
#, kde-format
msgid ""
"Multiple remote directories have this name. This ambiguous folder is read-"
"only; resolve it with rclone dedupe before changing it."
msgstr ""
"Varios directorios remotos tienen este nombre. Esta carpeta ambigua es de "
"solo lectura; resuélvala con rclone dedupe antes de modificarla."

#: src/kio/entrybuilder.cpp:134
#, kde-format
msgid ""
"Multiple remote objects have this name. KIO Rclone selected one read-only."
msgstr ""
"Varios objetos remotos tienen este nombre. KIO Rclone seleccionó uno de solo "
"lectura."

#: src/kio/worker.cpp:42
#, kde-format
msgid "“Configure Remotes…” is a virtual launcher and cannot be modified."
msgstr "«Configurar remotos…» es un lanzador virtual y no se puede modificar."

#: src/kio/worker.cpp:60
#, kde-format
msgid "My Drive"
msgstr "Mi unidad"

#: src/kio/worker.cpp:62
#, kde-format
msgid "Shared With Me"
msgstr "Compartido conmigo"

#: src/kio/worker.cpp:64
#, kde-format
msgid "Shared Drives"
msgstr "Unidades compartidas"

#: src/kio/worker.cpp:66
#, kde-format
msgid "Trash (original folder structure)"
msgstr "Papelera (estructura de carpetas original)"

#: src/kio/worker.cpp:68
#, kde-format
msgid "Starred"
msgstr "Favoritos"

#: src/kio/worker.cpp:70
#, kde-format
msgid "Folders by ID"
msgstr "Carpetas por ID"

#: src/kio/worker.cpp:72
#, kde-format
msgid "Folder %1"
msgstr "Carpeta %1"

#: src/kio/worker.cpp:89
#, kde-format
msgid ""
"Shows trashed items in their original folder structure. Some folders only "
"provide the path to a trashed item."
msgstr ""
"Muestra los elementos eliminados en la estructura de sus carpetas originales. "
"Algunas carpetas solo proporcionan la ruta hasta un elemento eliminado."

#: src/kio/worker.cpp:300
#, kde-format
msgid ""
"This Google Drive location is not valid. Open My Drive to browse the normal "
"Drive root."
msgstr ""
"Esta ubicación de Google Drive no es válida. Abre Mi unidad para explorar la "
"raíz normal de Drive."

#: src/kio/worker.cpp:332
#, kde-format
msgid "The rclone remote “%1” was not found."
msgstr "No se encontró el remoto de rclone «%1»."

#: src/kio/worker.cpp:731
#, kde-format
msgid "The remote file changed while it was being read."
msgstr "El archivo remoto cambió mientras se estaba leyendo."

#: src/kio/worker.cpp:769 src/kio/worker.cpp:924 src/kio/worker.cpp:1124
#, kde-format
msgid "This virtual folder cannot be modified."
msgstr "Esta carpeta virtual no se puede modificar."

#: src/kio/worker.cpp:773 src/kio/worker.cpp:928 src/kio/worker.cpp:1008
#: src/kio/worker.cpp:1128
#, kde-format
msgid ""
"This Google Drive view is read-only. Open My Drive or a Shared Drive to make "
"changes."
msgstr ""
"Esta vista de Google Drive es de solo lectura. Abre Mi unidad o una unidad "
"compartida para hacer cambios."

#: src/kio/worker.cpp:799
#, kde-format
msgid ""
"Multiple remote objects have this name. Rename or remove the duplicates "
"before editing this file."
msgstr ""
"Varios objetos remotos tienen este nombre. Renombre o elimine los duplicados "
"antes de editar este archivo."

#: src/kio/worker.cpp:804
#, kde-format
msgid ""
"This is an exported cloud document with no stable remote size. It is "
"available read-only to avoid replacing the original."
msgstr ""
"Este es un documento en la nube exportado sin un tamaño remoto estable. Está "
"disponible solo en lectura para evitar reemplazar el original."

#: src/kio/worker.cpp:825
#, kde-format
msgid "Preparing upload…"
msgstr "Preparando la subida…"

#: src/kio/worker.cpp:841 src/kio/worker.cpp:850
#, kde-format
msgid "The upload source changed size while it was being read."
msgstr "El origen de la subida cambió de tamaño mientras se estaba leyendo."

#: src/kio/worker.cpp:875
#, kde-format
msgid "The remote file changed while the local edit was being prepared."
msgstr "El archivo remoto cambió mientras se preparaba la edición local."

#: src/kio/worker.cpp:945
#, kde-format
msgid ""
"Multiple remote objects have this name. Resolve the duplicates before "
"creating this path."
msgstr ""
"Varios objetos remotos tienen este nombre. Resuelva los duplicados antes de "
"crear esta ruta."

#: src/kio/worker.cpp:1004
#, kde-format
msgid "A virtual folder cannot be renamed."
msgstr "Una carpeta virtual no se puede renombrar."

#: src/kio/worker.cpp:1012
#, kde-format
msgid ""
"Moving between different rclone remotes or Google Drive views is streamed by "
"KIO."
msgstr ""
"Mover entre remotos de rclone o vistas de Google Drive distintos se "
"transmite a través de KIO."

#: src/kio/worker.cpp:1037
#, kde-format
msgid ""
"Multiple remote objects have the source name. Resolve the duplicates before "
"renaming this path."
msgstr ""
"Varios objetos remotos tienen el nombre de origen. Resuelva los duplicados "
"antes de renombrar esta ruta."

#: src/kio/worker.cpp:1050
#, kde-format
msgid ""
"The destination is ambiguous or read-only and cannot be replaced safely."
msgstr ""
"El destino es ambiguo o de solo lectura y no se puede reemplazar de forma "
"segura."

#: src/kio/worker.cpp:1082
#, kde-format
msgid "“Configure Remotes…” is a virtual launcher and cannot be copied."
msgstr "«Configurar remotos…» es un lanzador virtual y no se puede copiar."

#: src/kio/worker.cpp:1148
#, kde-format
msgid ""
"Multiple remote objects have this name. Resolve the duplicates before "
"deleting this path."
msgstr ""
"Varios objetos remotos tienen este nombre. Resuelva los duplicados antes de "
"borrar esta ruta."

#: src/kio/worker.cpp:1212 app/configwindow.cpp:282
#, kde-format
msgid ""
"rclone was not found. Install it or set KIO_RCLONE_EXECUTABLE to its full "
"path."
msgstr ""
"No se encontró rclone. Instálelo o establezca KIO_RCLONE_EXECUTABLE con su "
"ruta completa."

#: src/kio/worker.cpp:1332
#, kde-format
msgid "Uploading… %1% · %2/s · %3 s remaining"
msgstr "Subiendo… %1% · %2/s · %3 s restantes"

#: src/kio/worker.cpp:1334
#, kde-format
msgid "Uploading… %1% · %2/s"
msgstr "Subiendo… %1% · %2/s"

#: src/kio/worker.cpp:1361
#, kde-format
msgid "Uploading…"
msgstr "Subiendo…"

#: src/kio/worker.cpp:1415
#, kde-format
msgid "The parent directory could not be resolved safely."
msgstr "No se pudo resolver el directorio padre de forma segura."

#: src/kio/worker.cpp:1418
#, kde-format
msgid "A parent path component is not a directory."
msgstr "Un componente de la ruta padre no es un directorio."

#: src/kio/worker.cpp:1422
#, kde-format
msgid ""
"A parent directory has multiple remote objects with the same name. Resolve "
"the duplicates before changing this path."
msgstr ""
"Un directorio padre tiene varios objetos remotos con el mismo nombre. "
"Resuelva los duplicados antes de cambiar esta ruta."

#: src/kio/worker.cpp:1526
#, kde-format
msgid ""
"Multiple remote objects have this name, and this backend cannot identify "
"which one to open safely."
msgstr ""
"Varios objetos remotos tienen este nombre y este motor no puede identificar "
"cuál abrir de forma segura."

#: app/dialogs/rclonepromptdialog.cpp:46
#, kde-format
msgid "rclone output:"
msgstr "Salida de rclone:"

#: app/dialogs/rclonepromptdialog.cpp:52
#, kde-format
msgid "rclone output"
msgstr "Salida de rclone"

#: app/dialogs/rclonepromptdialog.cpp:58
#, kde-format
msgid "Type a response and press Enter"
msgstr "Escriba una respuesta y pulse Intro"

#: app/dialogs/rclonepromptdialog.cpp:59
#, kde-format
msgid "Sends your response to the question shown by rclone."
msgstr "Envía su respuesta a la pregunta mostrada por rclone."

#: app/dialogs/rclonepromptdialog.cpp:60
#, kde-format
msgid "Response:"
msgstr "Respuesta:"

#: app/dialogs/settingsdialog.cpp:48
#, kde-format
msgid "Rclone Settings"
msgstr "Configuración de Rclone"

#: app/dialogs/settingsdialog.cpp:61
#, kde-format
msgid "Configure how Dolphin browses Rclone remotes."
msgstr "Configure cómo navega Dolphin por los remotos de Rclone."

#: app/dialogs/settingsdialog.cpp:70
#, kde-format
msgid "Folder listings"
msgstr "Listados de carpetas"

#: app/dialogs/settingsdialog.cpp:85
#, kde-format
msgid "Use recent listings (recommended)"
msgstr "Usar listados recientes (recomendado)"

#: app/dialogs/settingsdialog.cpp:89
#, kde-format
msgid "Always check the remote"
msgstr "Comprobar siempre el remoto"

#: app/dialogs/settingsdialog.cpp:96
#, kde-format
msgid ""
"Choose whether Dolphin may reuse a recently saved folder listing or requests "
"a new listing from the remote each time."
msgstr ""
"Elija si Dolphin puede reutilizar un listado de carpeta guardado "
"recientemente o si solicita uno nuevo al remoto cada vez."

#: app/dialogs/settingsdialog.cpp:100
#, kde-format
msgid "How to open folders"
msgstr "Cómo abrir carpetas"

#: app/dialogs/settingsdialog.cpp:103
#, kde-format
msgid "How to open folders:"
msgstr "Cómo abrir carpetas:"

#: app/dialogs/settingsdialog.cpp:118 app/dialogs/settingsdialog.cpp:210
#, kde-format
msgid " second"
msgid_plural " seconds"
msgstr[0] " segundo"
msgstr[1] " segundos"

#: app/dialogs/settingsdialog.cpp:121
#, kde-format
msgid ""
"How long Dolphin may reuse a saved folder listing before requesting a new "
"one from the remote."
msgstr ""
"Cuánto tiempo puede Dolphin reutilizar un listado de carpeta guardado antes "
"de solicitar uno nuevo al remoto."

#: app/dialogs/settingsdialog.cpp:125
#, kde-format
msgid "Keep listings for"
msgstr "Conservar los listados durante"

#: app/dialogs/settingsdialog.cpp:128
#, kde-format
msgid "Keep listings for:"
msgstr "Conservar los listados durante:"

#: app/dialogs/settingsdialog.cpp:146
#, kde-format
msgid "Saved listings"
msgstr "Listados guardados"

#: app/dialogs/settingsdialog.cpp:150 app/dialogs/settingsdialog.cpp:159
#, kde-format
msgid "Clear saved listings when saving"
msgstr "Borrar los listados guardados al guardar"

#: app/dialogs/settingsdialog.cpp:154
#, kde-format
msgid ""
"Removes locally saved folder listings when these settings are saved. Remote "
"files and folders are not affected."
msgstr ""
"Elimina los listados de carpetas guardados localmente al guardar esta "
"configuración. Los archivos y carpetas remotos no se ven afectados."

#: app/dialogs/settingsdialog.cpp:165
#, kde-format
msgid "Useful when a folder appears outdated. Remote files are never deleted."
msgstr ""
"Útil cuando una carpeta parece desactualizada. Los archivos remotos nunca se "
"eliminan."

#: app/dialogs/settingsdialog.cpp:253
#, kde-format
msgid ""
"Recently visited folders can open faster. Changes made through Dolphin still "
"check the remote."
msgstr ""
"Las carpetas visitadas recientemente pueden abrirse más rápido. Los cambios "
"realizados desde Dolphin siguen comprobando el remoto."

#: app/dialogs/settingsdialog.cpp:257
#, kde-format
msgid ""
"Opening a folder always requests a new listing from rclone and the remote "
"provider."
msgstr ""
"Abrir una carpeta siempre solicita un listado nuevo a rclone y al proveedor "
"remoto."

#: app/configwindow.cpp:105
#, kde-format
msgid "Google Drive"
msgstr "Google Drive"

#: app/configwindow.cpp:106
#, kde-format
msgid ""
"rclone opens a browser window to authorize with Google. This application "
"never receives or displays your OAuth token."
msgstr ""
"rclone abre una ventana del navegador para autorizar con Google. Esta "
"aplicación nunca recibe ni muestra su token de OAuth."

#: app/configwindow.cpp:108
#, kde-format
msgid "OneDrive"
msgstr "OneDrive"

#: app/configwindow.cpp:109
#, kde-format
msgid ""
"rclone opens a browser window to authorize with Microsoft, then you will be "
"asked which drive to use."
msgstr ""
"rclone abre una ventana del navegador para autorizar con Microsoft y después "
"se le preguntará qué unidad usar."

#: app/configwindow.cpp:111
#, kde-format
msgid "Dropbox"
msgstr "Dropbox"

#: app/configwindow.cpp:112
#, kde-format
msgid ""
"rclone opens a browser window to authorize with Dropbox. This application "
"never receives or displays your OAuth token."
msgstr ""
"rclone abre una ventana del navegador para autorizar con Dropbox. Esta "
"aplicación nunca recibe ni muestra su token de OAuth."

#: app/configwindow.cpp:114
#, kde-format
msgid "Other Providers…"
msgstr "Otros proveedores…"

#: app/configwindow.cpp:115
#, kde-format
msgid ""
"Opens a terminal running rclone's own configuration wizard, for any backend "
"not listed above (S3, WebDAV, SFTP, and more)."
msgstr ""
"Abre un terminal con el asistente de configuración propio de rclone, para "
"cualquier motor no listado arriba (S3, WebDAV, SFTP y más)."

#: app/configwindow.cpp:138 app/configwindow.cpp:139 app/configwindow.cpp:140
#, kde-format
msgid "Creation instructions"
msgstr "Instrucciones de creación"

#: app/configwindow.cpp:157
#, kde-format
msgid "<h2>Cloud storage in Dolphin</h2>"
msgstr "<h2>Almacenamiento en la nube en Dolphin</h2>"

#: app/configwindow.cpp:160
#, kde-format
msgid ""
"Connect a cloud provider to browse it in Dolphin under <b>rclone:/</b>. Your "
"configured remotes appear in the list below."
msgstr ""
"Conecte un proveedor de nube para explorarlo en Dolphin en <b>rclone:/</b>. "
"Sus remotos configurados aparecen en la lista de abajo."

#: app/configwindow.cpp:178
#, kde-format
msgid "Add Remote…"
msgstr "Añadir remoto…"

#: app/configwindow.cpp:179
#, kde-format
msgid "Refresh"
msgstr "Actualizar"

#: app/configwindow.cpp:180
#, kde-format
msgid "Settings…"
msgstr "Configuración…"

#: app/configwindow.cpp:181
#, kde-format
msgid "Directory listing settings"
msgstr "Configuración de los listados de directorios"

#: app/configwindow.cpp:193
#, kde-format
msgid "Open in Dolphin"
msgstr "Abrir en Dolphin"

#: app/configwindow.cpp:194
#, kde-format
msgid "Edit…"
msgstr "Editar…"

#: app/configwindow.cpp:195
#, kde-format
msgid "Reconnect…"
msgstr "Reconectar…"

#: app/configwindow.cpp:196
#, kde-format
msgid "Remove"
msgstr "Eliminar"

#: app/configwindow.cpp:251
#, kde-format
msgid "Unlock Configuration"
msgstr "Desbloquear la configuración"

#: app/configwindow.cpp:252
#, kde-format
msgid ""
"Your rclone configuration is encrypted. Enter its existing password to "
"unlock it for this session — this does not change the password."
msgstr ""
"Su configuración de rclone está cifrada. Introduzca su contraseña actual "
"para desbloquearla durante esta sesión; esto no cambia la contraseña."

#: app/configwindow.cpp:308
#, kde-format
msgid ""
"This Google Drive remote uses rclone's shared OAuth client. It is quota-"
"limited and is being retired during 2026."
msgstr ""
"Este remoto de Google Drive usa el cliente OAuth compartido de rclone. Tiene "
"cuota limitada y se retirará durante 2026."

#: app/configwindow.cpp:318
#, kde-format
msgid "No remotes yet. Use “Add Remote…” to connect your first cloud provider."
msgstr ""
"Aún no hay remotos. Use «Añadir remoto…» para conectar su primer proveedor "
"de nube."

#: app/configwindow.cpp:321
#, kde-format
msgid ""
"One Google Drive remote uses rclone's shared OAuth client. Configure your "
"own client to avoid quota delays and service interruption."
msgid_plural ""
"%1 Google Drive remotes use rclone's shared OAuth client. Configure your own "
"clients to avoid quota delays and service interruption."
msgstr[0] ""
"Un remoto de Google Drive usa el cliente OAuth compartido de rclone. "
"Configure su propio cliente para evitar retrasos de cuota e interrupciones "
"del servicio."
msgstr[1] ""
"%1 remotos de Google Drive usan el cliente OAuth compartido de rclone. "
"Configure sus propios clientes para evitar retrasos de cuota e "
"interrupciones del servicio."

#: app/configwindow.cpp:325
#, kde-format
msgid "One remote configured."
msgid_plural "%1 remotes configured."
msgstr[0] "Un remoto configurado."
msgstr[1] "%1 remotos configurados."

